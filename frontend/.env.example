# Copy this file to .env and fill in your own values.

# Google Sign-In. Vite only exposes env vars prefixed VITE_ to browser code,
# which is exactly the boundary that matters here: a Google OAuth Client ID
# is safe to ship to the browser (it's not a secret — Google Identity
# Services requires it client-side to render the button and mint a
# credential), but nothing else backend-related belongs behind this prefix.
# Never put GOOGLE_CLIENT_SECRET, DATABASE_URL, or JWT_SECRET here.
#
# Use the SAME client id as backend/.env's GOOGLE_CLIENT_ID — the backend
# verifies every Google credential's audience against its own copy, so the
# two must match or every Google sign-in will fail verification.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
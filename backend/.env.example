# Copy this file to .env and fill in your own values.

# PostgreSQL connection string used by Prisma.
#
# Local Postgres:
#   createdb aurelie
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurelie?schema=public"
#
# Docker (nothing to install):
#   docker run --name aurelie-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=aurelie -p 5432:5432 -d postgres:16
#
# Hosted free tiers (Neon, Supabase, Railway) work too — paste the string
# they give you. Managed providers usually need ?sslmode=require on the end.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurelie?schema=public"

# Used to sign login/session JWTs. Any long random string works for local dev.
JWT_SECRET=change-this-to-a-long-random-string

# Bootstrap SUPER_ADMIN account, created by `npm run seed` (idempotent — safe
# to re-run). Without this set, seed.js falls back to admin@aurelie.local /
# change-me-immediately — fine for local dev, NOT fine anywhere real.
SEED_SUPER_ADMIN_EMAIL=admin@aurelie.local
SEED_SUPER_ADMIN_PASSWORD=change-me-immediately

PORT=4000
